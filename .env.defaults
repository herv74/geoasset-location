POSTGRES_DB=geoassets
POSTGRES_USER=geoassets
POSTGRES_PASSWORD=geoassets
REDIS_TTL_SECONDS=86400

# === LLM (vía LiteLLM) ===
# Provider canónico: OpenAI gpt-4o-mini para los 3 pipelines.
# LiteLLM actúa como capa de abstracción: cambiar de proveedor (Bedrock,
# Azure OpenAI, Anthropic) sólo requiere sobreescribir estas variables en
# .env.secrets, sin tocar código (p.ej. bedrock/openai.gpt-oss-120b-1:0).
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_FALLBACK_MODEL=

# Agente CrewAI (búsqueda web)
AGENT_LITELLM_MODEL=openai/gpt-4o-mini
AGENT_LITELLM_FALLBACK_MODEL=

# Pipelines Maps y Documento
PIPELINE_LITELLM_MODEL=openai/gpt-4o-mini
PIPELINE_LITELLM_FALLBACK_MODEL=

LITELLM_MAX_WORKERS=5
LITELLM_TIMEOUT=30

# Scoring
CONFIDENCE_THRESHOLD_HIGH=0.65
CONFIDENCE_THRESHOLD_MEDIUM=0.35
